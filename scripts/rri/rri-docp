#!/bin/bash
# rri-docp: fill in the reading radiologist (CD-DOCP) on charnew charges
# that came in from the facility as 00, using the read in openemr.
# run after rrr250 loads charnew and before coding (xxx003c).
#   rrr255       charnew 00s -> docp-extract
#   rri_docp.php docp-extract -> docp-answers (openemr fhir)
#   rrr256       docp-answers -> charnew, report docp-report,
#                changed records backed up whole to docp-bak-<timestamp>
# needs BASE_OEMR_URL, OEMR_RRI_SITE_ID, OEMR_TEST_CLIENT_ID,
# OEMR_RRI_USERNAME, OEMR_RRI_PASSWORD set, same as reads.php.
cd /home/rri || exit 1

PHP_DIR=/home/stee/src/cms/php/rri
stamp=$(date +%Y%m%d%H%M%S)

S30=charnew; S35=garfile; S40=docp-extract
export S30 S35 S40
$RUNCBL /home/sidw/rrr255.acu || exit 1
unset S30 S35 S40

if [ ! -s docp-extract ]; then
    echo "no 00 charges in charnew, nothing to do"
    exit 0
fi

rm -f docp-answers
php "$PHP_DIR/rri_docp.php" docp-extract docp-answers || exit 1
if [ ! -s docp-answers ]; then
    echo "rri_docp.php wrote no answers, charnew not touched"
    exit 1
fi

S30=docp-answers; S35=charnew; S40=docp-report; S45=docp-bak-$stamp
export S30 S35 S40 S45
$RUNCBL /home/sidw/rrr256.acu
rc=$?
unset S30 S35 S40 S45
cat docp-report >> docp-report.log
exit $rc
