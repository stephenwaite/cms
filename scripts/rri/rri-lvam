#!/bin/bash
# rri-lvam: build the LVAM request sheet the Medicare contractor wants with a
# Part B reopening request for 25 or more claims with the same correction.
#   cptfind       the list -> lvam-report and lvam-rows: garno from the MRN,
#                 the charge on the DOS in charcur, the Medicare ICN from
#                 caredetl (the newest remit that is not a takeback) or,
#                 for a line caredetl does not have, from carefile
#   lvam_fill.php lvam-rows + the blank LVAM sheet -> lvam-<cpt>-<timestamp>.xlsx
# garfile, charcur, carefile and caredetl are only read. the list is tab
# delimited or the fixed layout, see rri/reports/cptfind.cob. only charges
# with a Medicare ICN go in the sheet; read lvam-report for the rest (no
# account, no charge on the DOS, no ICN, taken back, no Medicare id) and for
# where each ICN came from (SRC). caredetl is loaded by care-detl-load; with
# no caredetl in /home/rri the ICNs are carefile's, which can be out of date
# for a claim Medicare reprocessed or took back.
#   rri-lvam <list> <blank LVAM sheet> "<correction>"
#   CPTWANT=70460 rri-lvam <list> <blank LVAM sheet> "<correction>"
#   CAREFILE=<file> rri-lvam ...      when carefile has another name
#   CAREDETL=<file> rri-lvam ...      the same for caredetl
if [ $# -ne 3 ] || [ -z "$3" ]; then
    echo 'usage: [CPTWANT=70450] rri-lvam <list> <blank LVAM sheet> "<correction>"'
    exit 1
fi
for f in "$1" "$2"; do
    if [ ! -r "$f" ]; then
        echo "rri-lvam: cannot read $f (from $PWD)"
        exit 1
    fi
done
list=$(readlink -f "$1")
blank=$(readlink -f "$2")
cd /home/rri || exit 1

PHP_DIR=/home/stee/src/cms/php/rri
stamp=$(date +%Y%m%d%H%M%S)
sheet=lvam-${CPTWANT:-70450}-$stamp.xlsx

rm -f lvam-rows
S30=garfile; S35=charcur; S40=${CAREFILE:-carefile}; S55=$list
S60=lvam-report; S65=lvam-rows
export S30 S35 S40 S55 S60 S65
detl=${CAREDETL:-caredetl}
if [ -e "$detl" ]; then
    S45=$detl
    export S45
else
    echo "*** no $detl in /home/rri: the ICNs are carefile's ***"
fi
$RUNCBL /home/sidw/cptfind.acu || exit 1
unset S30 S35 S40 S45 S55 S60 S65

sed -n '/INPUT ROWS/,$p' lvam-report
if [ ! -s lvam-rows ]; then
    echo "no charge with a Medicare ICN found, no sheet written. see /home/rri/lvam-report"
    exit 1
fi

php "$PHP_DIR/lvam_fill.php" lvam-rows "$blank" "$sheet" "$3" || exit 1
echo "sheet: /home/rri/$sheet   report: /home/rri/lvam-report"
