#!/bin/bash
# iedi-ca: process the 277s downloaded to /tmp/w22$USER
#   iedi-276      in /home/sidw  caid835 each download into /home/sidw/iediin276
#   iedi-277      /home/rri/iedi-277, neicoe277 for rri    -> /home/rri/iediout3
#   iedi-pet-277  in /home/sidw  npi277oe per openemr site  -> /home/sidw/iediout3oe
# rejections from both are combined in /home/sidw/iediout3, started fresh each
# run; the iediout3-MMDDYY-HHMM copies keep the history

SIDW=/home/sidw
RRI=/home/rri
STAMP=$(date +%m%d%y-%H%M)
HEADER_BYTES=28        # iediout3 is just the parm139 heading when nothing rejected

if [ ! -s "/tmp/w22$USER" ]; then
  echo "no 277s were downloaded, exiting..."
  exit 0
fi

# run a step in its own directory, stop the whole run if it fails.
# full paths: PATH has "." ahead of /home/sidw, and /home/sidw/iedi-277
# is a different script from /home/rri/iedi-277
run() {
  ( cd "$1" && "$1/$2" ) || { echo "iedi-ca: $2 failed in $1, stopping" >&2; exit 1; }
}

run "$SIDW" iedi-276
run "$RRI"  iedi-277
cp "$RRI/iediout3" "$SIDW/iediout3"
run "$SIDW" iedi-pet-277
cat "$SIDW/iediout3oe" >> "$SIDW/iediout3"

cp -p "$SIDW/iediout3"   "$SIDW/iediout3-$STAMP"
cp -p "$SIDW/iediout3oe" "$SIDW/iediout3oe-$STAMP"

if [ "$(wc -c < "$SIDW/iediout3")" -ne "$HEADER_BYTES" ]; then
  joe "$SIDW/iediout3"
  exit 0
fi
echo "no errors in the 277s!"
